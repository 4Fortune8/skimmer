[Unit]
Description=Skimmer YouTube and profile collection workflow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orangepi
WorkingDirectory=/home/orangepi/code_projects/skimmer
Environment=YOUTUBE_HEADLESS=false
Environment=VIDIQ_HEADLESS=true
Environment=SOCIALBLADE_HEADLESS=false
Environment=SOCIALBLADE_CHANNEL_DELAY_SECONDS=120
Environment=SOCIALBLADE_PAGE_DELAY_SECONDS=20
Environment=SOCIALBLADE_FIREFOX_PROFILE_DIR=/home/orangepi/.local/share/skimmer/socialblade-firefox-profile
Environment=SOCIALBLADE_CLOUDFLARE_BACKOFF_SECONDS=21600
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/orangepi/code_projects/skimmer/src
Environment=SKIMMER_FEED_CYCLE_SECONDS=900
Environment=YOUTUBE_HOME_PASSES=6
Environment=YOUTUBE_STALE_HOME_NEW_CHANNEL_THRESHOLD=30
Environment=YOUTUBE_DISCOVERY_SEED_LIMIT=5
Environment=YOUTUBE_DISCOVERY_MIN_SUBSCRIBERS=100
Environment=YOUTUBE_DISCOVERY_MAX_SUBSCRIBERS=1000000
Environment=YOUTUBE_DISCOVERY_MIN_VIDEO_VIEWS=10000
Environment=YOUTUBE_DISCOVERY_VIDEO_LOOKBACK_DAYS=90
Environment=YOUTUBE_DISCOVERY_SEED_COOLDOWN_DAYS=7
Environment=YOUTUBE_RECOMMENDATION_SCROLL_STEPS=8
Environment=YOUTUBE_API_CYCLE_SECONDS=86400
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1920x1080x24" /usr/bin/python3 -m skimmer.services.workflow
Nice=10
CPUWeight=20
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
